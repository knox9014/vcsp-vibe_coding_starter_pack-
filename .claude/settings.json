{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git init)",
      "Bash(git stash push *)",
      "Bash(git stash list)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(node --version)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(git --version)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "Bash(git config user.name *)",
      "Bash(git config user.email *)",
      "Bash(git config core.quotepath false)",
      "Bash(git init -b main)",
      "Bash(git remote -v)",
      "Bash(git branch --show-current)",
      "Bash(py *)",
      "Bash(py --version)",
      "Bash(chmod +x *.command)",
      "Bash(git rev-parse --is-inside-work-tree)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(pip install *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git revert *)",
      "Bash(git stash pop *)",
      "Bash(git stash drop *)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip *)",
      "Bash(python3 -m pip *)",
      "Bash(py -m pip *)",
      "Bash(brew install *)",
      "Bash(winget install *)",
      "Read(./my-project/data/**)",
      "Read(./*/data/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.local)",
      "Edit(./.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
